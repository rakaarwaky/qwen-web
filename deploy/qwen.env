# Qwen Web Automation - Environment Configuration
# Copy to /etc/qwen-web-automation/qwen.env and set permissions:
#   sudo chmod 600 /etc/qwen-web-automation/qwen.env
#   sudo chown qwen:qwen /etc/qwen-web-automation/qwen.env

ENVIRONMENT=production
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qwen-web-automation
QWEN_INPUT_DIR=/opt/qwen-web-automation/input
QWEN_OUTPUT_DIR=/opt/qwen-web-automation/output
QWEN_LOG_DIR=/opt/qwen-web-automation/log
QWEN_SESSION_DIR=/opt/qwen-web-automation/qwen_session
